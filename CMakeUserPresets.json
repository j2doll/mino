      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_EXAMPLES": "ON",
        "ENABLE_TESTS": "OFF",
        "ENABLE_EXAMPLE_CORE": "ON",
        "ENABLE_EXAMPLE_EXTERNAL": "ON",
        "ENABLE_EXAMPLE_NETWORK": "ON",
        "ENABLE_EXAMPLE_NETWORK_CURL": "ON",
        "ENABLE_EXAMPLE_NETWORK_LIBSSH2": "ON",
