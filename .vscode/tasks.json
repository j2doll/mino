{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure Preset",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--preset",
                "${input:selectedPreset}"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake Build Preset",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "${input:selectedPreset}" ], // 전체 빌드
            // "args": [ "--build", "--preset", "${input:selectedPreset}",
            //   "--target", "core_bit_example" ], // 특정 타겟만 빌드하려면 주석 해제 후 사용. 빌드 속도 빠름.
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc", "$msCompile"]
        }
    ],
    "inputs": [
        {
            "id": "selectedPreset",
            "type": "pickString",
            "description": "사용할 CMake Preset을 선택하세요",
            "options": [
                "linux-gcc-debug",
                "linux-gcc-release",
                "vs-debug",
                "vs-release"
            ],
            "default": "linux-gcc-debug"
        }
    ]
}