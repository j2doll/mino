{
    // .vscode/tasks.json

    "version": "2.0.0",

    "tasks": [
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake -S . -B build -G \"Ninja\" -DCMAKE_CXX_STANDARD=17 -DCMAKE_BUILD_TYPE=Debug; cmake --build build -j",
            "group": {
                "kind": "build",
                "isDefault": true,
            },
            "problemMatcher": ["$gcc"],
            "detail": "Generated task by CMake Tools",
        }
    ]
}