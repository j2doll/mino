{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++: Build and Debug",
      "type": "cppdbg",
      "request": "launch",
      // 최상위 검사 통과용 기본 경로 (OS 블록에 의해 오버라이드됨)
      "program": "${workspaceFolder}/out/build/${input:selectedPreset}/example/core/bit/core_bit_example",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "preLaunchTask": "CMake Build Preset",

      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder}/out/build/${input:selectedPreset}/example/core/bit/Debug/core_bit_example.exe",
        "console": "integratedTerminal"
      },

      "linux": {
        "type": "cppdbg",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb",
        "program": "${workspaceFolder}/out/build/${input:selectedPreset}/example/core/bit/core_bit_example",
        "externalConsole": false,
        "setupCommands": [
          {
            "description": "gdb pretty-printing 활성화",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      }
    }
  ],
  "inputs": [
    {
      "id": "selectedPreset",
      "type": "pickString",
      "description": "사용할 CMake Preset을 선택하세요",
      "options": [
        "linux-gcc-debug",
        "linux-gcc-release",
        "vs-debug",
        "vs-release"
      ],
      "default": "linux-gcc-debug"
    }
  ]
}