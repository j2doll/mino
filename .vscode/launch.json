{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++: Build and Debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/program_name",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "preLaunchTask": "CMake Build Preset",

      "windows": {
        "type": "cppvsdbg",
        // TODO: VSCode + Windows Visual Studio 컴파일러 환경에서 디버깅할 프로그램(debugee)를 지정.
        "program": "${workspaceFolder}/out/build/${input:selectedPreset}/example/core/bit/Debug/core_bit_example.exe",
        "console": "integratedTerminal",
        // "nativeDebugging": false,
        // "launchBrowser": false
      },

      "linux": {
        "type": "cppdbg",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb", // TODO: Linux gdb 경로 지정
        // TODO: VSCode + Linux gcc 컴파일러 환경에서 디버깅할 프로그램(debugee)를 지정.
        "program": "${workspaceFolder}/out/build/${input:selectedPreset}/example/core/bit/core_bit_example",
        "externalConsole": false,
        "setupCommands": [
          {
            "description": "Activate gdb pretty-printing.",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      }
    }
  ],
  "inputs": [
    {
      "id": "selectedPreset",
      "type": "pickString",
      "description": "Select the CMake Preset to use.",
      "options": [
        "linux-gcc-debug",
        "linux-gcc-release",
        "vs-debug",
        "vs-release"
      ],
      "default": "linux-gcc-debug"
    }
  ]
}
