{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++: Build and Debug",
      "type": "cppdbg",
      "request": "launch",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "preLaunchTask": "CMake Build Preset",
      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder}/out/build/${input:selectedPreset}/example/core/bit/Debug/core_bit_example.exe", // TODO: Set the path to the program to debug for Windows.
        "console": "integratedTerminal"
      },
      "linux": {
        "type": "cppdbg",
        "MIMode": "gdb",
        "miDebuggerPath": "/usr/bin/gdb", // TODO: Set the path to the gdb debugger if different.
        "program": "${workspaceFolder}/build/${input:selectedPreset}/example/core/bit/core_bit_example", // TODO: Set the path to the program to debug for Linux.
        "externalConsole": false,
        "setupCommands": [
          {
            "description": "Activate gdb pretty-printing.",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      }
    }
  ],
  "inputs": [
    {
      "id": "selectedPreset",
      "type": "pickString",
      "description": "Select the CMake Preset to use.",
      "options": [
        "linux-gcc-debug",
        "linux-gcc-release",
        "vs-debug",
        "vs-release"
      ],
      "default": "linux-gcc-debug"
    }
  ]
}

