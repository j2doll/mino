    },
    {
      "name": "Windows: Release",
      "type": "cppvsdbg",
      "request": "launch",
      // "program": "${workspaceFolder}/out/build/vs-release/example/core/bit/Release/core_bit_example.exe",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
