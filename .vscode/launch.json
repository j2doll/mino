{
  "version": "0.2.0",
  "configurations": [
    // ================= Linux =================
    {
      "name": "Linux: Debug",
      "type": "cppdbg",
      "request": "launch",
      // "program": "${workspaceFolder}/build/linux-gcc-debug/example/core/bit/core_bit_example",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Activate gdb pretty-printing.",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Linux: Release",
      "type": "cppdbg",
      "request": "launch",
      // "program": "${workspaceFolder}/build/linux-gcc-release/example/core/bit/core_bit_example",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb"
    },

    // ================= Windows =================
    {
      "name": "Windows: Debug",
      "type": "cppvsdbg",
      "request": "launch",
      // "program": "${workspaceFolder}/out/build/vs-debug/example/core/bit/Debug/core_bit_example.exe",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
