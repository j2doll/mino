{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mino",
  "version-string": "1.0.0",
  "dependencies": [
    "brotli",
    "cgltf",
    {
      "name": "cpp-httplib",
      "features": [
        "brotli"
      ]
    },
    {
      "name": "curl",
      "features": [
        "non-http",
        "openssl",
        "ssh",
        "ssl",
        "sspi"
      ]
    },
    "dirent",
    "drlibs",
    "fmt",
    "glfw3",
    {
      "name": "libssh2",
      "features": [
        "openssl",
        "zlib"
      ]
    },
    "miniaudio",
    "mmx",
    "nanosvg",
    "nlohmann-json",
    "openssl",
    "qoi",
    {
      "name": "spdlog",
      "features": [
        "fmt",
        "tz-offset"
      ]
    },
    "stb",
    "yaml-cpp",
    "zlib"
  ]
}
